{
  "buildCommand": "npm run build",
  "installCommand": "npm install --prefix . && npm install --prefix frontend",
  "framework": null,
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/**,api/_handlers/**,api/_auth/**,api/_users/**,api/_units/**,api/_agendamentos/**,api/_dashboard/**,api/_ifct/**,api/_rondas/**,api/_viaturas/**,api/_viatura-historico/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "cleanUrls": false
}

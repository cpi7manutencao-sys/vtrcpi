# ============================================================
# VITE - variaveis expostas ao frontend (PUBLICAS)
# Devem ser prefixadas com VITE_ pra Vite expor no build
# ============================================================

# Google OAuth Client ID (obrigatório)
# Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# API Base - deixar vazio em prod (Vercel serve /api relativo)
# Pra dev local com `vercel dev`, deixar vazio também
# Pra apontar pra outro backend (ex: staging): VITE_API_BASE=https://staging.app.vercel.app
VITE_API_BASE=

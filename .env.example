# =============================================================
# Sistema de Viaturas CPI-7 - Env vars (TEMPLATE)
# Copie pra .env e preencha com os valores reais.
# .env ja ta no .gitignore - NAO COMMITEAR!
# =============================================================

# --- SMTP (Gmail) - email de notificacao de aprovacao ---------
# App Password do Gmail (https://myaccount.google.com/apppasswords)
# Em dev local, a intranet PM bloqueia SMTP externo - use SMTP_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=app-password-de-16-chars
SMTP_FROM_NAME=Sistema de Viaturas CPI-7

# Em dev local, defina SMTP_MOCK=true pra apenas LOGAR o email
# (sem mandar de verdade). Em prod (Vercel), REMOVA esta linha.
SMTP_MOCK=true

# --- URL base do sistema (usada no link IFCT do email) ---------
APP_BASE_URL=http://localhost:5174

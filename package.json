{
  "name": "viaturas-cpi7-vercel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx server-local.mjs",
    "dev:web": "cd frontend && npm run dev",
    "dev": "node -e \"console.log('Use npm run dev:api (terminal 1) e npm run dev:web (terminal 2)')\"",
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup-local.ps1",
    "reset": "powershell -ExecutionPolicy Bypass -File ./reset-local.ps1",
    "set-google": "powershell -ExecutionPolicy Bypass -File ./set-google-id.ps1",
    "build": "cd frontend && node ./node_modules/vite/bin/vite.js build",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pdfkit": "^0.17.6",
    "@vercel/node": "^5.0.0",
    "@vercel/postgres": "^0.10.0",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "google-auth-library": "^9.14.0",
    "jose": "^5.9.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.20.2",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
